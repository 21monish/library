# Sevalla injects these values when its PostgreSQL database is attached to the
# application. Keep them available at both build time and runtime. DB_URL is not
# required when all five component values are present. This file is a template:
# enter real passwords and secrets only in the Sevalla dashboard, never here.
DB_HOST=internal-database-host
DB_PORT=5432
DB_DATABASE=shelfwise
DB_USERNAME=shelfwise_app
DB_PASSWORD=replace-with-sevalla-database-password
DATABASE_SSL_REQUIRE=false
SECRET_KEY=replace-with-a-new-long-random-production-secret
DJANGO_DEBUG=false
TIME_ZONE=Asia/Kolkata
ALLOWED_HOSTS=your-application.sevalla.app
CSRF_TRUSTED_ORIGINS=https://your-application.sevalla.app
SECURE_SSL_REDIRECT=true

# Production email delivery
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Shelfwise Library <noreply@example.com>
PASSWORD_RESET_TIMEOUT=3600

# Mount a Sevalla persistent disk at this path for book covers and profile photos.
MEDIA_ROOT=/app/media
ASSET_UPLOAD_MAX_BYTES=3145728

# Circulation policy
# Student and teacher loan periods are fixed by policy at 15 and 30 days.
LOAN_LIMIT_STUDENT=3
LOAN_LIMIT_TEACHER=10
PENALTY_PER_DAY=10
MAX_RENEWALS=1
