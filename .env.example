# Copy the URI from Supabase: Project Settings > Database > Connection string.
# Use the session pooler URI for persistent servers or the transaction pooler
# for serverless deployments. Replace the placeholder password and URL-encode
# special characters in it.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_DEBUG=false
TIME_ZONE=Asia/Kolkata
ALLOWED_HOSTS=your-service.onrender.com
CSRF_TRUSTED_ORIGINS=https://your-service.onrender.com
SECURE_SSL_REDIRECT=true

# Production email delivery
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Shelfwise Library <noreply@example.com>
PASSWORD_RESET_TIMEOUT=3600

# Supabase Storage (use a rotated server-side key, never the publishable key)
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=replace-with-rotated-server-side-secret
SUPABASE_STORAGE_BUCKET=library-assets
ASSET_UPLOAD_MAX_BYTES=3145728

# Circulation policy
# Student and teacher loan periods are fixed by policy at 15 and 30 days.
LOAN_LIMIT_STUDENT=3
LOAN_LIMIT_TEACHER=10
PENALTY_PER_DAY=10
MAX_RENEWALS=1
